DATABASE_URL=postgres://postgres:postgres@localhost:5432/massalia
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me-in-development-at-least-32-characters
PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
# Show the (unwired) Discord/Google/Facebook sign-in buttons. Leave unset in production.
VITE_SOCIAL_LOGIN=false
# Keep the campaign map read-only until player-to-polity and war rules replace
# the deliberate placeholders in apps/server/src/services/mapWar.ts.
MAP_MUTATIONS_ENABLED=false

# Nightly Postgres backup (worker, 03:30 UTC): pg_dump | gzip -> S3-compatible
# bucket as massalia-YYYY-MM-DD.dump.gz, keeping 30 days. All four must be set or
# the job logs a skip line. BACKUP_S3_REGION is optional (default "auto").
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
